# Managed by Ansible - do not edit manually
{% set timer_hour = item.hour | default(4 + ((item.index * 15) // 60)) | int %}
{% set timer_minute = item.minute | default((item.index * 15) % 60) | int %}
[Unit]
Description=Daily timer for Rclone sync ({{ item.name }})

[Timer]
OnCalendar=*-*-* {{ "%02d:%02d:00" | format(timer_hour, timer_minute) }}
Persistent=true
Unit=rclone-sync-{{ item.name }}.service

[Install]
WantedBy=timers.target
