---
# Template for expected variables in host_vars/<host>/vault.yml
# This file serves as documentation and reference before encryption with ansible-vault.

# Decryption passphrase for LUKS block device (/dev/sda or /dev/sdb)
luks_pass: "CHANGE_ME_LUKS_PASSPHRASE"

# sha512crypt password hash for ansible_user sudo account
# Generated e.g. using: python3 -c 'import crypt, secrets; print(crypt.crypt("my_password", crypt.mksalt(crypt.METHOD_SHA512)))'
user_password: "$6$..."

# Sudo privilege escalation password
# Used by Ansible during connection/bootstrap when passwordless sudo is not yet active
ansible_become_password: "CHANGE_ME_SUDO_PASSWORD"
